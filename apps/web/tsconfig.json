{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target":  "ES2022",
    "lib":     ["dom", "dom.iterable", "ES2022"],
    "module":  "ESNext",
    "jsx":     "preserve",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
