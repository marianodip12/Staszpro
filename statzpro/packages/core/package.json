{
  "name": "@sportiq/core",
  "version": "0.1.0",
  "description": "SportIQ — Pure sport domain: types, entities, analysis logic. No UI, no DB, no browser APIs.",
  "type": "module",
  "exports": {
    ".":           "./src/index.ts",
    "./types":     "./src/types/index.ts",
    "./domain":    "./src/domain/index.ts",
    "./handball":  "./src/sports/handball/index.ts"
  },
  "scripts": {
    "build":     "tsc -p tsconfig.json",
    "test":      "vitest run",
    "test:watch":"vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest":     "^2.1.0"
  }
}
