---
import { SITE, NAV } from '../consts';

interface Props {
  title: string;
  description: string;
  /** Canonical relativo a base, ej: "/como-hacer-estadisticas" o "/" para el índice */
  path: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  image = `${SITE.base}/og-default.png`,
  type = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(SITE.base + path, SITE.url).href.replace(/\/$/, '') || SITE.url;
const ogImage = image.startsWith('http') ? image : new URL(image, SITE.url).href;
const fullTitle = path === '/' ? title : `${title} · ${SITE.title}`;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="StatzPro" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/statzpro-favicon.svg" />
    <link rel="sitemap" href={`${SITE.base}/sitemap.xml`} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={`${SITE.base}/rss.xml`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <header class="site-header">
      <nav class="wrap nav">
        <a href={SITE.base} class="brand">
          <span class="mark">S</span> Statz<b>Pro</b> <span class="sep">/</span> Blog
        </a>
        <div class="links">
          {NAV.map((i) => <a href={i.href}>{i.label}</a>)}
        </div>
      </nav>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          <strong>StatzPro</strong> — análisis de handball para entrenadores.
          <a href="https://statzpro.com">Probá la app gratis</a>.
        </p>
        <p class="muted">© {new Date().getFullYear()} StatzPro</p>
      </div>
    </footer>

    <style is:global>
      :root {
        --bg: #090e1a;
        --bg-2: #0d1424;
        --fg: #e7ecf4;
        --muted: #9aa7bd;
        --line: #1e293b;
        --accent: #4ea1e6;
        --accent-2: #7dd3b0;
        --radius: 14px;
        --wrap: 720px;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font: 400 18px/1.7 'Inter', -apple-system, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .wrap { width: 100%; max-width: var(--wrap); margin: 0 auto; padding: 0 20px; }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .muted { color: var(--muted); }
      .skip { position: absolute; left: -9999px; }
      .skip:focus { left: 12px; top: 12px; background: var(--accent); color: #001; padding: 8px 12px; border-radius: 8px; z-index: 10; }

      .site-header { border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 92%, #000); position: sticky; top: 0; z-index: 5; backdrop-filter: blur(6px); }
      .nav { display: flex; align-items: center; justify-content: space-between; height: 60px; }
      .brand { color: var(--fg); font-weight: 800; letter-spacing: -.3px; display: flex; align-items: center; gap: 8px; }
      .brand b { color: var(--accent-2); font-weight: 800; }
      .brand .sep { color: var(--muted); font-weight: 400; }
      .brand .mark { width: 26px; height: 26px; border-radius: 8px; background: linear-gradient(135deg, #1d9e75, #378add); display: grid; place-items: center; font-size: 15px; color: #fff; }
      .links { display: flex; gap: 18px; font-size: 15px; }
      .links a { color: var(--muted); }
      .links a:hover { color: var(--fg); text-decoration: none; }

      main { padding: 48px 20px 72px; }

      h1, h2, h3 { line-height: 1.25; letter-spacing: -.5px; color: #fff; }
      h1 { font-size: 40px; font-weight: 800; margin: 0 0 12px; }
      h2 { font-size: 27px; font-weight: 700; margin: 44px 0 12px; }
      h3 { font-size: 21px; font-weight: 700; margin: 32px 0 8px; }
      p { margin: 0 0 18px; }
      ul, ol { margin: 0 0 18px; padding-left: 24px; }
      li { margin: 6px 0; }
      strong { color: #fff; }
      blockquote { margin: 24px 0; padding: 4px 18px; border-left: 3px solid var(--accent); color: var(--muted); }
      code { background: var(--bg-2); border: 1px solid var(--line); border-radius: 6px; padding: 1px 6px; font-size: .9em; }
      hr { border: none; border-top: 1px solid var(--line); margin: 40px 0; }
      table { width: 100%; border-collapse: collapse; margin: 24px 0; font-size: 15px; display: block; overflow-x: auto; }
      th, td { border: 1px solid var(--line); padding: 8px 12px; text-align: left; }
      th { background: var(--bg-2); color: #fff; }
      img { max-width: 100%; height: auto; border-radius: var(--radius); }

      .site-footer { border-top: 1px solid var(--line); padding: 32px 0; font-size: 15px; color: var(--muted); }
      .site-footer .wrap p { margin: 4px 0; }

      .cta {
        margin: 40px 0; padding: 22px 24px; border: 1px solid var(--line);
        border-radius: var(--radius); background: linear-gradient(180deg, var(--bg-2), var(--bg));
      }
      .cta h3 { margin: 0 0 6px; }
      .cta p { margin: 0 0 14px; color: var(--muted); }
      .btn { display: inline-block; background: var(--accent); color: #001018; font-weight: 700; padding: 10px 18px; border-radius: 10px; }
      .btn:hover { text-decoration: none; filter: brightness(1.05); }

      @media (max-width: 640px) {
        h1 { font-size: 31px; }
        h2 { font-size: 23px; }
        body { font-size: 17px; }
        .links a:not(:last-child) { display: none; }
      }
    </style>
  </body>
</html>
