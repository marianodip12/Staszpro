{
  "name": "sportiq",
  "private": true,
  "version": "0.1.0",
  "description": "SportIQ — Unified sports intelligence platform",
  "scripts": {
    "build":        "turbo run build",
    "dev":          "turbo run dev --parallel",
    "lint":         "turbo run lint",
    "test":         "turbo run test",
    "test:watch":   "turbo run test:watch",
    "typecheck":    "turbo run typecheck",
    "clean":        "turbo run clean && rm -rf node_modules",
    "db:migrate":   "supabase db push",
    "db:types":     "supabase gen types typescript --local > packages/core/src/types/supabase.ts"
  },
  "devDependencies": {
    "turbo":           "^2.3.0",
    "typescript":      "^5.6.0",
    "@types/node":     "^22.0.0",
    "prettier":        "^3.3.0",
    "eslint":          "^9.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}
