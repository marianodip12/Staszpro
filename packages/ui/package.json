{
  "name": "@sportiq/ui",
  "version": "0.1.0",
  "description": "SportIQ — Shared UI primitives (buttons, inputs, dialogs, toasts, ProGate). Tailwind-compatible, design-token aware.",
  "type": "module",
  "exports": {
    ".":            "./src/index.ts",
    "./button":     "./src/button.tsx",
    "./input":      "./src/input.tsx",
    "./dialog":     "./src/dialog.tsx",
    "./toast":      "./src/toast.tsx",
    "./pro-gate":   "./src/pro-gate.tsx",
    "./skeleton":   "./src/skeleton.tsx",
    "./empty":      "./src/empty.tsx",
    "./spinner":    "./src/spinner.tsx",
    "./error-fallback": "./src/error-fallback.tsx",
    "./utils":      "./src/utils.ts"
  },
  "scripts": {
    "build":     "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react":     ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@sportiq/core":          "workspace:*",
    "@radix-ui/react-dialog": "^1.1.0",
    "lucide-react":           "^0.468.0",
    "clsx":                   "^2.1.0",
    "tailwind-merge":         "^2.5.0"
  },
  "devDependencies": {
    "@types/react":     "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript":       "^5.6.0"
  }
}
