{
  "name": "@sportiq/media",
  "version": "0.1.0",
  "description": "SportIQ — Pure media domain: video assets, clip signatures, render jobs, storage abstraction. No sport logic.",
  "type": "module",
  "exports": {
    ".":         "./src/index.ts",
